# Local Payment SDK demo configuration.
# Copy this file to .env and fill the secret/local values before running samples.
# Binaries use the process environment only. Explicitly source a trusted copy
# with `set -a; source payment_sdk_demo/.env; set +a` before running a sample.

# Required exact mode for either embedded Indexer Service sample. The checked-in
# local template selects global-trusted mode; use exact `true` and provide the
# matching bearer variables for strict mode.
STRICT_AUTHENTICATION_MODE=false

# -----------------------------------------------------------------------------
# Bitcoin indexer sample: cargo run --locked -p payment_sdk_demo --bin bitcoin-indexer
# -----------------------------------------------------------------------------
DEMO_BITCOIN_NETWORK=regtest
DEMO_BITCOIN_CORE_RPC_URL=http://127.0.0.1:18443
DEMO_BITCOIN_EXPECTED_GENESIS_HASH=0f9188f13cb7b2c71f2a335e3a4fc328bf5beb436012afca590b1a11466e2206

# Fill with the complete Bitcoin Core Authorization header value. Quote it
# because Basic authorization contains a space, for example:
# DEMO_BITCOIN_CORE_AUTHORIZATION="Basic <base64-cookie-or-rpc-user-pass>"
DEMO_BITCOIN_CORE_AUTHORIZATION=

# Required only in strict mode. Never commit a populated value.
DEMO_BITCOIN_IX_BEARER_TOKEN=

DEMO_BITCOIN_INDEXER_DATABASE_PATH=./tmp/bitcoin-indexer-demo-db
DEMO_BITCOIN_INDEXER_HTTP_BIND=127.0.0.1:18080
DEMO_BITCOIN_INDEXER_METRICS_BIND=127.0.0.1:19090
DEMO_BITCOIN_BOOTSTRAP_HEIGHT=0
DEMO_BITCOIN_CONFIRMATION_DEPTH=2
DEMO_BITCOIN_REORG_RETENTION=100
DEMO_BITCOIN_RPC_TIMEOUT_SECONDS=15
DEMO_BITCOIN_POLL_SECONDS=5
DEMO_BITCOIN_READY_MAX_LAG=2
DEMO_BITCOIN_READY_MAX_AGE_SECONDS=30

# -----------------------------------------------------------------------------
# Ethereum indexer sample: cargo run --locked -p payment_sdk_demo --bin indexer
# -----------------------------------------------------------------------------
# Fill from: cast block 0 --field hash --rpc-url http://127.0.0.1:8545
IX_EXPECTED_GENESIS_HASH=
# Required only in strict mode. Never commit a populated value.
IX_BEARER_TOKEN=
