# Optional local shell environment for `payment-api`.
#
# Runtime topology, RPC endpoints, network identity, and redb file paths belong
# in the JSON configuration passed to the executable. Only the inbound bearer
# secret stays in the process environment. The configuration chooses this
# variable by name through `bearer_token_env`.
#
# Copy this file to an untracked local file, set mode 600, replace the value,
# and source only that trusted local copy. Never commit a real token.

export PAYMENT_API_TOKEN='replace-with-a-long-random-local-secret'

# Keep loopback RPC traffic out of ambient proxies during local development.
export NO_PROXY='127.0.0.1,localhost'
export no_proxy="${NO_PROXY}"
