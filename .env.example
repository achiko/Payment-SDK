# Manual disposable local-stack environment.
#
# Copy this file to .env, set mode 600, fill every empty value, and source it
# from each terminal. This file is shell-compatible configuration: source only
# a local copy that you trust. Never commit the populated .env file.

# One fresh identifier per Anvil + custody lifecycle. Use letters, digits, and
# hyphens only, for example: anvil-20260807-01
export LOCAL_RUN_ID=''
export LOCAL_RUN_ROOT="./tmp/payment-sdk-manual-${LOCAL_RUN_ID}"

# Shared local Ethereum identity.
export ETHEREUM_RPC_URL='http://127.0.0.1:8545'
export ETHEREUM_CHAIN_ID='31337'
export PAYMENT_NETWORK='anvil'
export RUST_LOG='info'
export NO_PROXY='127.0.0.1,localhost'
export no_proxy="${NO_PROXY}"

# Indexer Service. Fill the genesis hash after starting this run's Anvil.
export IX_DATABASE_PATH="${LOCAL_RUN_ROOT}/indexer/database"
export IX_NETWORK="${PAYMENT_NETWORK}"
export IX_BOOTSTRAP_HEIGHT='0'
export IX_EXPECTED_CHAIN_ID="${ETHEREUM_CHAIN_ID}"
export IX_EXPECTED_GENESIS_HASH=''
export IX_RPC_HTTP_URL="${ETHEREUM_RPC_URL}"
export IX_HTTP_BIND='127.0.0.1:8080'
export IX_METRICS_BIND='127.0.0.1:9090'
export IX_BEARER_TOKEN=''

# Loopback-only ephemeral development custody.
export CUSTODY_BIND='127.0.0.1:8181'
export CUSTODY_BEARER_TOKEN=''

# Stateless Wallet Service. The custody token must be the same token accepted
# by custody; the assignment below keeps that equality in one place.
export WS_ETHEREUM_CHAIN_ID="${ETHEREUM_CHAIN_ID}"
export WS_ETHEREUM_RPC_URL="${ETHEREUM_RPC_URL}"
export WS_CUSTODY_URL='http://127.0.0.1:8181'
export WS_CUSTODY_BEARER_TOKEN="${CUSTODY_BEARER_TOKEN}"
export WS_BEARER_TOKEN=''
export WS_HTTP_BIND='127.0.0.1:8082'

# Payment Service. Its IX and WS credentials must match those services. Its
# ordinary and administrator client tokens must be different from one another.
export PS_DATABASE_PATH="${LOCAL_RUN_ROOT}/payment/database"
export PS_POLICY_PATH="${LOCAL_RUN_ROOT}/payment/policy.json"
export PS_INDEXER_URL='http://127.0.0.1:8080'
export PS_INDEXER_NETWORK="${PAYMENT_NETWORK}"
export PS_INDEXER_BEARER_TOKEN="${IX_BEARER_TOKEN}"
export PS_WALLET_URL='http://127.0.0.1:8082'
export PS_WALLET_BEARER_TOKEN="${WS_BEARER_TOKEN}"
export PS_API_BEARER_TOKEN=''
export PS_ADMIN_BEARER_TOKEN=''
export PS_HTTP_BIND='127.0.0.1:8081'
export PS_METRICS_BIND='127.0.0.1:9091'

# Private helper files used only by the manual commands in the runbook.
export GAS_FUNDER_RESPONSE_PATH="${LOCAL_RUN_ROOT}/payment/gas-funder.json"
export PS_ADMIN_STATUS_PATH="${LOCAL_RUN_ROOT}/payment/admin-status.json"

# Bitcoin block-only v1 examples.
#
# These lines are intentionally commented so sourcing this file continues to
# start the Ethereum local-stack defaults above. Use a separate private env for
# each Bitcoin IX/WS/PS process, uncomment only the settings for that process,
# and inject authentication values without committing them. Bitcoin Core must
# be a locally synchronized, unpruned 31.x node with txindex enabled and current.
# For non-regtest networks, monitor peer connectivity and tip freshness
# independently; the service probes only the configured Core node.

# Bitcoin Indexer Service: `indexer-worker bitcoin serve`.
# `IX_EXPECTED_GENESIS_HASH` is conventional 64-character Bitcoin display order
# with no `0x` prefix. Confirmation and retention have no Bitcoin defaults.
# export IX_DATABASE_PATH='./tmp/payment-sdk-bitcoin/indexer/database'
# export IX_NETWORK='regtest'
# export IX_BOOTSTRAP_HEIGHT='0'
# export IX_CONFIRMATION_DEPTH=''
# export IX_REORG_RETENTION=''
# export IX_EXPECTED_GENESIS_HASH=''
# export IX_RPC_HTTP_URL='http://127.0.0.1:18443'
# `IX_RPC_HEADERS` must contain exactly one protected `authorization=...`
# entry. Bitcoin IX also requires its own non-empty API bearer token.
# export IX_RPC_HEADERS=''
# export IX_RPC_TIMEOUT_SECONDS='15'
# Bitcoin IX uses verbosity-2 blocks plus at most four concurrent cached
# external-prevout calls and retains only bounded value/address evidence.
# export IX_RPC_MAX_RESPONSE_BYTES='268435456'
# export IX_BEARER_TOKEN=''
# export IX_HTTP_BIND='127.0.0.1:8080'
# export IX_METRICS_BIND='127.0.0.1:9090'

# Bitcoin Wallet Service: `wallet-worker bitcoin serve`.
# The shared local custody above is ephemeral: restarting it destroys every
# generated private key. Use it only for disposable regtest/local addresses.
# Core authorization may be supplied by `WS_BITCOIN_CORE_RPC_AUTHORIZATION` or
# one `authorization=...` entry in `WS_BITCOIN_CORE_RPC_HEADERS`, never both.
# The shared WS custody/listener settings above also apply to Bitcoin mode.
# export WS_BITCOIN_NETWORK='regtest'
# export WS_BITCOIN_EXPECTED_GENESIS_HASH=''
# export WS_BITCOIN_CORE_RPC_URL='http://127.0.0.1:18443'
# Choose exactly one Core Authorization form and leave the other undefined.
# export WS_BITCOIN_CORE_RPC_HEADERS=''
# export WS_BITCOIN_CORE_RPC_AUTHORIZATION=''
# export WS_BITCOIN_IX_URL='http://127.0.0.1:8080'
# Copy the same private token accepted by IX into the WS process environment;
# separate process env files cannot resolve one another's variables.
# export WS_BITCOIN_IX_BEARER_TOKEN=''
# export WS_BITCOIN_MINIMUM_CONFIRMATIONS=''
# Maximum is Bitcoin Core's 1 BTC/kvB limit: 100000000 sat/kvB.
# export WS_BITCOIN_MAX_SATOSHIS_PER_KVB=''
# export WS_BITCOIN_FEE_TARGET_BLOCKS='6'

# Bitcoin Payment Service: `payment-api bitcoin serve`.
# The policy is a separate strict JSON file; see docs/BITCOIN_SERVICES.md. PS
# does not call Core directly and must use its own database, never the IX path.
# export PS_DATABASE_PATH='./tmp/payment-sdk-bitcoin/payment/database'
# export PS_POLICY_PATH='./tmp/payment-sdk-bitcoin/payment/policy.json'
# export PS_INDEXER_URL='http://127.0.0.1:18080'
# export PS_INDEXER_NETWORK='regtest'
# Bitcoin PS requires the IX bearer even when IX is on loopback.
# export PS_INDEXER_BEARER_TOKEN=''
# export PS_WALLET_URL='http://127.0.0.1:18082'
# export PS_WALLET_BEARER_TOKEN=''
# Ordinary and administrator client credentials must be non-empty and distinct.
# export PS_API_BEARER_TOKEN=''
# export PS_ADMIN_BEARER_TOKEN=''
# export PS_HTTP_BIND='127.0.0.1:18081'
# export PS_METRICS_BIND='127.0.0.1:19091'
# export PS_TLS_TERMINATED_UPSTREAM='false'
# export PS_WORKER_INTERVAL_MILLIS='1000'
# export PS_WORKER_PAGE_SIZE='100'
# export PS_SHUTDOWN_GRACE_SECONDS='10'

# This repository does not create a populated `.env` automatically. The direct
# offline `payment_sdk_demo` Bitcoin wallet and Payment Service binaries need no
# environment file; only the Core-backed Bitcoin indexer demo uses one.
